clear
clc
close all

%values from the book
a1 = 5;
b1 = 3;
a2 = 0.1;
b2 = 1.3;
d1 =0.4;
d2 = 0.01;


X0 = 0.8;   
Y0 = 0.3;  
Z0 = 8;   

y0 = [X0 Y0 Z0];


tspan = [0 250];


[t,y] = ode45(@(t,y) plants_hare_lynx(t,y,a1,a2,b1,b2,d1,d2), tspan, y0);


X = y(:,1);
Y = y(:,2);
Z = y(:,3);

% 3D plot
figure
plot3(X,Y,Z,'LineWidth',1.5)
grid on

xlabel('Plants (X)')
ylabel('Herbivores / Hares (Y)')
zlabel('Carnivores / Lynx (Z)')

title('Three-Species Food Chain Dynamics')
view(45,25)

figure("Name",'plant-hare-lynx')
plot(t,y)
title('plant-hare-lynx Populations Over Time')
xlabel('Time [months]')
ylabel('Population')
legend('plant','hare', 'lynx','Location','North')
